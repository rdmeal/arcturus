{
  "name": "@arcturus/example-service",
  "private": true,
  "type": "module",
  "scripts": {
    "db:commit": "vp run -w fmt:sql && graphile-migrate commit",
    "db:reset": "graphile-migrate reset --erase",
    "db:uncommit": "graphile-migrate uncommit",
    "db:watch": "graphile-migrate watch",
    "dev": "graphile-migrate migrate && node --watch --import @arcturus/service-runtime/telemetry src/main.ts",
    "start": "node --import @arcturus/service-runtime/telemetry src/main.ts"
  },
  "dependencies": {
    "@arcturus/service-runtime": "workspace:*",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arcturus/service-testing": "workspace:*",
    "@types/node": "^26.6.6",
    "fishery": "^2.4.0",
    "graphile-migrate": "^1.4.1",
    "msw": "^3.0.7"
  }
}
